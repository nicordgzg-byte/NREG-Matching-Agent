PORT=3000
DATABASE_FILE=./data/nreg.sqlite

# Supabase server-side storage for Vercel. Use the secret key only on the server.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# WhatsApp Business Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_APP_SECRET=
WHATSAPP_MATCH_TEMPLATE_NAME=nreg_match_alert
WHATSAPP_MATCH_TEMPLATE_LANGUAGE=es_MX

# Comma-separated phone numbers in international format, without + or spaces.
ADMIN_PHONE_NUMBERS=5215555555555

# Optional panel protection. Leave blank for local-only development.
ADMIN_PANEL_TOKEN=

# Optional AI extraction. Without these values, the deterministic parser is used.
OPENAI_API_KEY=
OPENAI_MODEL=
